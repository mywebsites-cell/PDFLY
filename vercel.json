{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=UTF-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=UTF-8" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "key": "host", "value": "www.pdfly.live" }],
      "destination": "https://pdfly.live/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "key": "host", "value": "pdfly.live" },
        { "type": "header", "key": "x-forwarded-proto", "value": "http" }
      ],
      "destination": "https://pdfly.live/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/home", "destination": "/" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
